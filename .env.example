# ═══════════════════════════════════════════
# App Interfone — Environment Variables
# ═══════════════════════════════════════════

# ─── Server ────────────────────────────────
PORT=3001
NODE_ENV=development

# JWT — em produção, gerar 32+ caracteres aleatórios.
# Ex: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-secret-change-in-production-32chars!!

# ─── Origens permitidas (CSV) ──────────────
# Em produção, listar exatamente os domínios do frontend/app.
ALLOWED_ORIGINS=https://appinterfone.com.br,https://www.appinterfone.com.br,capacitor://localhost

# ─── Modo demo / contas de exemplo ─────────
# DEMO_MODE: cria condomínio + contas demo no startup e habilita /api/auth/demo.
# SAMPLE_ACCOUNTS_ON_REGISTER: cria "Morador Exemplo" e "Porteiro Exemplo" ao registrar condomínio.
# Padrão em produção: ambos false.
DEMO_MODE=false
SAMPLE_ACCOUNTS_ON_REGISTER=false

# ─── Amazon SES — E-mail ───────────────────
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here
AWS_SES_REGION=sa-east-1
SES_FROM_EMAIL=naoresponda@appinterfone.com.br
SES_FROM_NAME=App Interfone

# ─── URL pública do app ────────────────────
APP_URL=https://appinterfone.com.br

# ─── Firebase Cloud Messaging ──────────────
# Sem isto, o PUSH (campainha do celular) fica DESLIGADO em produção.
# Opção A (recomendada no servidor): JSON da service account inline, em UMA
#   única linha (minificado). NUNCA usar aspas em volta. Tem prioridade sobre o PATH.
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opção B: caminho para o arquivo JSON (NUNCA commitar o arquivo).
FIREBASE_SERVICE_ACCOUNT_PATH=./server/firebase-service-account.json

# ─── Web Push (VAPID) ──────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@appinterfone.com.br

# ─── Android Build (CI) ────────────────────
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0

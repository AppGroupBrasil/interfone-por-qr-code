{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmitOnError": false,
    "outDir": "./dist-server",
    "rootDir": "./server",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["server"],
  "//": "Os testes rodam pelo vitest; o bundle de produção não leva vitest nem supertest.",
  "exclude": ["server/__tests__", "server/**/*.test.ts"]
}
